<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  xmlns:system="clr-namespace:System"
  mc:Ignorable="d">

  <!-- COLORS & BRUSHES -->
  <Color x:Key="Color_Transparent">#00FFFFFF</Color>
  <Color x:Key="Color_White_1_Official">#FFF2F2F2</Color>
  <Color x:Key="Color_Blue_1_Official">#2aa6e2</Color>
  <Color x:Key="Color_Blue_2_Unofficial">#1968a6</Color>
  <Color x:Key="Color_Blue_3_Official">#124c7a</Color>
  <Color x:Key="Color_Blue_4_Official">#0e3b5e</Color>
  <Color x:Key="Color_Gray_1_System">#282828</Color>
  <Color x:Key="Color_Gray_2_Unofficial">#444444</Color>
  <Color x:Key="Color_Orange_1_Unofficial">#e58819</Color>
  <Color x:Key="Color_Orange_2_Unofficial">#FFF2A024</Color>

  <Color x:Key="Color_YouTubeRed_Official">#FFFF0033</Color>
  <LinearGradientBrush x:Key="Gradient_Blue_45Deg" EndPoint="1,1">
    <GradientStop Color="{DynamicResource Color_Blue_4_Official}" Offset="0"/>
    <GradientStop Color="{DynamicResource Color_Blue_2_Unofficial}" Offset="1"/>
    <GradientStop Color="{DynamicResource Color_Blue_3_Official}" Offset="0.5"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Gradient_Blue_90Deg" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="{DynamicResource Color_Blue_4_Official}" Offset="0"/>
    <GradientStop Color="{DynamicResource Color_Blue_2_Unofficial}" Offset="1"/>
    <GradientStop Color="{DynamicResource Color_Blue_3_Official}" Offset="0.5"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Gradient_Blue_Glow_90Deg" StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.25">
    <GradientStop Color="{DynamicResource Color_Blue_1_Official}" Offset="1"/>
    <GradientStop Color="{DynamicResource Color_Transparent}" Offset="0"/>
  </LinearGradientBrush>

  <DropShadowEffect x:Key="DropShadowEffect_FrameOuterGlow" Direction="-90" Color="{DynamicResource Color_Blue_1_Official}" BlurRadius="24" Opacity="0.1" ShadowDepth="1"/>

  <DropShadowEffect Color="{DynamicResource Color_Blue_1_Official}" BlurRadius="40" ShadowDepth="0" Opacity="0.501" Direction="90" x:Key="DropShadowEffect_ImageOverlayObjectsGlows"/>
  <Thickness x:Key="Thickness_FrameBorderThickness">1</Thickness>
  <Thickness x:Key="Thickness_TilingOuterMargin_Omni">8,8,8,8</Thickness>

  <Thickness x:Key="Thickness_TilingOuterMargin_LeftRight">8,0,8,0</Thickness>
  <CornerRadius x:Key="CornerRadius_Level1">4,4,4,4</CornerRadius>

  <CornerRadius x:Key="CornerRadius_Level2">2,2,2,2</CornerRadius>
  <FontFamily x:Key="FontFamily_PrimaryFont">Fonts/#Noto Sans, Fonts/#Symbols</FontFamily>

  <system:Single x:Key="Single_TextSize_10">10</system:Single>
  <system:Single x:Key="Single_TextSize_11">11</system:Single>
  <system:Single x:Key="Single_TextSize_16">16</system:Single>
  <system:Single x:Key="Single_TextSize_20">20</system:Single>
  <DropShadowEffect x:Key="DropShadowEffect_TextOuterGlow" Color="#FFCCCCCC" ShadowDepth="0" Direction="-90"/>


  <!-- IMAGES -->
  <ImageSource x:Key="Image.Home.Bugs">Images/Home/Bugs.png</ImageSource>
  <ImageSource x:Key="Image.Home.Changelog">Images/Home/Changelog.png</ImageSource>
  <ImageSource x:Key="Image.Home.Docs">Images/Home/Docs.png</ImageSource>
  <ImageSource x:Key="Image.Home.Forums">Images/Home/Forums.png</ImageSource>
  <ImageSource x:Key="Image.Learn.DocsNoesisGUI">Images/Learn/DocsNoesisGUI.png</ImageSource>
  <ImageSource x:Key="Image.Learn.DocsStudio">Images/Learn/DocsStudio.png</ImageSource>
  <ImageSource x:Key="Image.Learn.VideoCharSel">Images/Learn/VideoCharacterSelection.png</ImageSource>
  <ImageSource x:Key="Image.Learn.VideoData">Images/Learn/VideoData.png</ImageSource>
  <ImageSource x:Key="Image.Learn.VideoMainMenu">Images/Learn/VideoMainMenu.png</ImageSource>
  <ImageSource x:Key="Image.Learn.VideoNewEra">Images/Learn/VideoNewEra.png</ImageSource>
  <ImageSource x:Key="Image.Learn.VideoPaths">Images/Learn/VideoPaths.png</ImageSource>
  <ImageSource x:Key="Image.Learn.VideoStyles">Images/Learn/VideoTemplatesStyles.png</ImageSource>
  <ImageSource x:Key="Image.Samples.BackgroundEffect">Images/Samples/BackgroundEffect.png</ImageSource>
  <ImageSource x:Key="Image.Samples.BrushShaders">Images/Samples/BrushShaders.png</ImageSource>
  <ImageSource x:Key="Image.Samples.CustomControl">Images/Samples/CustomControl.png</ImageSource>
  <ImageSource x:Key="Image.Samples.CustomRender">Images/Samples/CustomRender.png</ImageSource>
  <ImageSource x:Key="Image.Samples.DataBinding">Images/Samples/DataBinding.png</ImageSource>
  <ImageSource x:Key="Image.Samples.HelloWorld">Images/Samples/HelloWorld.png</ImageSource>
  <ImageSource x:Key="Image.Samples.Inventory">Images/Samples/Inventory.png</ImageSource>
  <ImageSource x:Key="Image.Samples.Localization">Images/Samples/Localization.png</ImageSource>
  <ImageSource x:Key="Image.Samples.LoginDialog">Images/Samples/LoginDialog.png</ImageSource>
  <ImageSource x:Key="Image.Samples.Menu3D">Images/Samples/Menu3D.png</ImageSource>
  <ImageSource x:Key="Image.Samples.QuestLog">Images/Samples/QuestLog.png</ImageSource>
  <ImageSource x:Key="Image.Samples.Rive">Images/Samples/Rive.png</ImageSource>
  <ImageSource x:Key="Image.Samples.Scoreboard">Images/Samples/Scoreboard.png</ImageSource>
  <ImageSource x:Key="Image.Samples.StartMenu">Images/Samples/StartMenu.png</ImageSource>
  <ImageSource x:Key="Image.Samples.TicTacToe">Images/Samples/TicTacToe.png</ImageSource>
  <ImageSource x:Key="Image.Samples.UserControl">Images/Samples/UserControl.png</ImageSource>
  <ImageSource x:Key="Image.Samples.VideoEffect">Images/Samples/VideoEffect.png</ImageSource>
  <ImageSource x:Key="Image.Samples.WorldSpaceUI">Images/Samples/WorldSpaceUI.png</ImageSource>

  <!-- STYLES -->
   <ControlTemplate x:Key="Template_TabControl_PageComposition" TargetType="TabControl">
    <Grid x:Name="Master_Grid" d:DataContext="DataSet_Unity">
      <TabPanel IsItemsHost="True" Panel.ZIndex="1" Background="#00FFFFFF" KeyboardNavigation.TabIndex="1"/>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="Template_ListBoxItem_SideBarButton" TargetType="ListBoxItem">
    <ControlTemplate.CustomProperties>
      <CustomProperty Name="Icon" Type="DataTemplate"/>
    </ControlTemplate.CustomProperties>
    <Grid x:Name="Master_Grid" Cursor="Hand" d:DesignWidth="512" d:DesignHeight="256">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="SelectionStates">
          <VisualStateGroup.Transitions>
            <VisualTransition GeneratedDuration="00:00:00.1000000" To="Selected"/>
            <VisualTransition From="Selected" GeneratedDuration="00:00:00.1500000"/>
            <VisualTransition GeneratedDuration="00:00:00.1000000" To="SelectedUnfocused"/>
            <VisualTransition From="SelectedUnfocused" GeneratedDuration="00:00:00.1500000"/>
          </VisualStateGroup.Transitions>
          <VisualState x:Name="Unselected"/>
          <VisualState x:Name="Selected">
            <Storyboard>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Frame_Outline_Border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="00:00:00" Value="{DynamicResource Color_Blue_1_Official}"/>
              </ColorAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Outline_Border" Storyboard.TargetProperty="(Border.BorderBrush).(Brush.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="0.05"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_DropShadow_Border" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="0.5"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_Gradient_Group" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="0.499"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Content_Layout_Grid" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="SelectedUnfocused">
            <Storyboard>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Frame_Outline_Border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                <LinearColorKeyFrame Value="{DynamicResource Color_Blue_1_Official}" KeyTime="0:0:0"/>
              </ColorAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Outline_Border" Storyboard.TargetProperty="(Border.BorderBrush).(Brush.Opacity)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.05"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_DropShadow_Border" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame Value="0.5" KeyTime="0:0:0"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_Gradient_Group" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame Value="0.5" KeyTime="0:0:0"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Content_Layout_Grid" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions>
            <VisualTransition GeneratedDuration="00:00:00.1000000" To="MouseOver"/>
            <VisualTransition From="MouseOver" GeneratedDuration="00:00:00.1500000"/>
          </VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="MouseOver">
            <Storyboard>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="MouseOver_Label_TextBlock" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="00:00:00" Value="{DynamicResource Color_Blue_1_Official}"/>
              </ColorAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MouseOver_Grid" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_ColorOverlay_Border" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
              </DoubleAnimationUsingKeyFrames>
              <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="MouseOver_Icon_Host">
                <LinearColorKeyFrame Value="{DynamicResource Color_Blue_1_Official}" KeyTime="0:0:0"/>
              </ColorAnimationUsingKeyFrames>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="MouseOver_OutlineBorder" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="00:00:00" Value="{DynamicResource Color_Blue_4_Official}"/>
              </ColorAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Disabled"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid x:Name="ButtonArea_Margined_Grid" Margin="8,4,8,4">
        <Grid x:Name="ButtonArea_Sizer_Grid" Height="56">
          <Grid x:Name="MouseOver_Grid">
            <Border x:Name="MouseOver_OutlineBorder" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}">
              <Border.Background>
                <SolidColorBrush Color="{DynamicResource Color_Gray_2_Unofficial}" Opacity="0.3"/>
              </Border.Background>
            </Border>
            <Grid x:Name="MouseOver_Content_Layout_Grid" Height="40" Margin="8,8,8,8" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="MouseOver_Label_TextBlock" Margin="0,0,8,0" VerticalAlignment="Bottom" FontFamily="{DynamicResource FontFamily_PrimaryFont}" FontSize="{DynamicResource Single_TextSize_10}" FontWeight="Black" TextWrapping="Wrap">
                <TextBlock.Foreground>
                  <SolidColorBrush Color="{DynamicResource Color_White_1_Official}"/>
                </TextBlock.Foreground>
                <TextBlock.Text>
                  <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}" FallbackValue="Label">
                    <Binding.Converter>
                      <noesis:CaseConverter/>
                    </Binding.Converter>
                  </Binding>
                </TextBlock.Text>
              </TextBlock>
              <ContentControl x:Name="MouseOver_Icon_Host" Content=" " Width="20" Height="20" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" ContentTemplate="{Binding Path=(Custom.Icon_DataTemplate), RelativeSource={RelativeSource TemplatedParent}}">
                <ContentControl.Foreground>
                  <SolidColorBrush Color="{DynamicResource Color_White_1_Official}"/>
                </ContentControl.Foreground>
              </ContentControl>
            </Grid>
          </Grid>
          <Grid x:Name="Frame_Grid">
            <Border x:Name="Frame_Background_DropShadow_Border" Opacity="0" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}" Effect="{DynamicResource DropShadowEffect_FrameOuterGlow}" Background="{DynamicResource Gradient_Blue_90Deg}"/>
            <Grid x:Name="Frame_Background_Gradient_Group" Opacity="0">
              <Border x:Name="Frame_Background_Gradient_Border" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}" Background="{DynamicResource Gradient_Blue_90Deg}" BorderBrush="{DynamicResource Gradient_Blue_90Deg}"/>
              <Border x:Name="Frame_Background_ColorOverlay_Border" Opacity="0.5" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}" Background="{DynamicResource Gradient_Blue_Glow_90Deg}"/>
            </Grid>
            <Border x:Name="Frame_Outline_Border" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}">
              <Border.Background>
                <SolidColorBrush Color="{DynamicResource Color_Blue_1_Official}" Opacity="0"/>
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource Color_Gray_2_Unofficial}" Opacity="0"/>
              </Border.BorderBrush>
            </Border>
          </Grid>
          <Grid x:Name="Content_Margined_Grid" Margin="8,8,8,8">
            <Grid x:Name="Content_Layout_Grid" Height="40" VerticalAlignment="Center" Opacity="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Label_TextBlock" TextWrapping="Wrap" VerticalAlignment="Bottom" FontFamily="{DynamicResource FontFamily_PrimaryFont}" FontSize="{DynamicResource Single_TextSize_10}" FontWeight="Black" Margin="0,0,8,0">
                <TextBlock.Foreground>
                  <SolidColorBrush Color="{DynamicResource Color_White_1_Official}"/>
                </TextBlock.Foreground>
                <TextBlock.Text>
                  <Binding Path="Content" RelativeSource="{RelativeSource TemplatedParent}" FallbackValue="Label">
                    <Binding.Converter>
                      <noesis:CaseConverter/>
                    </Binding.Converter>
                  </Binding>
                </TextBlock.Text>
              </TextBlock>
              <ContentControl x:Name="Icon_Host" Content=" " Width="20" Height="20" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" ContentTemplate="{Binding Path=(Custom.Icon_DataTemplate), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </ControlTemplate>

  <Style x:Key="Style_ListBoxItem_SideBarButton" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template" Value="{StaticResource Template_ListBoxItem_SideBarButton}"/>
  </Style>

  <ControlTemplate x:Key="Template_TabControl_TabItem" TargetType="TabItem">
    <ControlTemplate.CustomProperties>
      <CustomProperty Name="Icon" Type="DataTemplate"/>
    </ControlTemplate.CustomProperties>
    <Grid x:Name="Master_Grid" d:DesignWidth="512" d:DesignHeight="256">
      <ListBoxItem Style="{StaticResource Style_ListBoxItem_SideBarButton}" Content="{Binding Path=Header, RelativeSource={RelativeSource TemplatedParent}}" Custom.Icon_DataTemplate="{Binding Path=(Custom.Icon_DataTemplate), RelativeSource={RelativeSource TemplatedParent}}" IsSelected="{Binding Path=IsSelected, RelativeSource={RelativeSource TemplatedParent}}">
        <b:Interaction.Triggers>
          <b:EventTrigger x:Name="OnClick_Set_IsSelected_ToTrue" EventName="PreviewMouseDown">
            <b:ChangePropertyAction x:Name="Set_IsSelected_ToTrue" PropertyName="IsSelected" Value="True"/>
          </b:EventTrigger>
        </b:Interaction.Triggers>
      </ListBoxItem>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="Template_Button_LinkBarButton" TargetType="Button">
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Master_Grid" Property="Cursor" Value="Hand"/>
      </Trigger>
    </ControlTemplate.Triggers>
    <Grid x:Name="Master_Grid">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions>
            <VisualTransition GeneratedDuration="00:00:00.1000000" To="MouseOver"/>
            <VisualTransition From="MouseOver" GeneratedDuration="00:00:00.1500000"/>
          </VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="MouseOver">
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_Border" Storyboard.TargetProperty="(Panel.Background).(Brush.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="0.05"/>
              </DoubleAnimationUsingKeyFrames>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Icon_ContentControl" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="00:00:00" Value="{DynamicResource Color_Blue_1_Official}"/>
              </ColorAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Pressed"/>
          <VisualState x:Name="Disabled"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="Frame_Background_Border" CornerRadius="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource Color_Blue_1_Official}" Opacity="0"/>
        </Border.Background>
      </Border>
      <ContentControl x:Name="Icon_ContentControl" Content="ContentControl" HorizontalAlignment="Center" Margin="4,4,4,4" ContentTemplate="{Binding Path=ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}">
        <ContentControl.Foreground>
          <SolidColorBrush Color="{DynamicResource Color_White_1_Official}"/>
        </ContentControl.Foreground>
      </ContentControl>
    </Grid>
  </ControlTemplate>
  
  <ControlTemplate x:Key="Template_Button_Tile" TargetType="Button">
    <Grid x:Name="Master_Grid" Cursor="Hand">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="MouseOver">
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Outline_Border" Storyboard.TargetProperty="(Border.BorderBrush).(Brush.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="0.5"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shadow_Box" Storyboard.TargetProperty="(UIElement.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shadow_Box" Storyboard.TargetProperty="(NoesisGUIExtensions.BoxShadow.BlurRadius)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="15"/>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Pressed"/>
          <VisualState x:Name="Disabled"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid x:Name="ButtonArea_Margined_Grid">
        <Grid x:Name="Frame_Grid">
          <noesis:BoxShadow x:Name="Shadow_Box" BlurRadius="10" Direction="-80" Depth="2" Color="#33000000" Opacity="0"/>
          <Border x:Name="Frame_Background_Gradient_Border" Opacity="0.2" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}" BlendingMode="Multiply">
            <Border.Background>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="{DynamicResource Color_Blue_4_Official}" Offset="0"/>
                <GradientStop Offset="1" Color="{DynamicResource Color_Blue_4_Official}"/>
                <GradientStop Color="{DynamicResource Color_Blue_3_Official}" Offset="0.5"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border x:Name="Frame_Outiline_Gradient_Border" Opacity="0" BorderBrush="{DynamicResource Gradient_Blue_90Deg}" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}"/>
          <Border x:Name="Frame_Outline_Border" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}">
            <Border.Background>
              <SolidColorBrush Color="{DynamicResource Color_Blue_1_Official}" Opacity="0"/>
            </Border.Background>
            <Border.BorderBrush>
              <SolidColorBrush Color="{DynamicResource Color_Blue_1_Official}" Opacity="0"/>
            </Border.BorderBrush>
          </Border>
        </Grid>
        <Grid x:Name="Content_Margined_Grid" Margin="16,16,16,16">
          <ContentPresenter/>
        </Grid>
      </Grid>
    </Grid>
  </ControlTemplate>

  <ItemsPanelTemplate x:Key="Template_ListBox_ItemsPanel_TilePresenter_2Wide">
    <UniformGrid Columns="2" Margin="{DynamicResource Thickness_TilingOuterMargin_Omni}"/>
  </ItemsPanelTemplate>
  <ControlTemplate x:Key="Template_Button_NewVersionDownload" TargetType="Button">
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Master_Grid" Property="Cursor" Value="Hand"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True"/>
    </ControlTemplate.Triggers>
    <Grid x:Name="Master_Grid" MinHeight="24" d:DesignWidth="512" d:DesignHeight="256">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions>
            <VisualTransition GeneratedDuration="00:00:00.1000000" To="MouseOver"/>
            <VisualTransition From="MouseOver" GeneratedDuration="00:00:00.1500000"/>
            <VisualTransition GeneratedDuration="00:00:00.0500000" To="Pressed"/>
            <VisualTransition From="Pressed" GeneratedDuration="00:00:00.1000000"/>
          </VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="MouseOver">
            <Storyboard>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_Border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="00:00:00" Value="{DynamicResource Color_Orange_2_Unofficial}"/>
              </ColorAnimationUsingKeyFrames>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="VersionName_TextBlock" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="00:00:00" Value="{DynamicResource Color_Orange_2_Unofficial}"/>
              </ColorAnimationUsingKeyFrames>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="ExternalLinkIcon_TextBlock" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="00:00:00" Value="{DynamicResource Color_Orange_2_Unofficial}"/>
              </ColorAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Frame_Background_Border" Storyboard.TargetProperty="(Panel.Background).(Brush.Opacity)">
                <LinearDoubleKeyFrame KeyTime="00:00:00" Value="0.05"/>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Pressed"/>
          <VisualState x:Name="Disabled"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border x:Name="Frame_Background_Border" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}">
        <Border.BorderBrush>
          <SolidColorBrush Color="{DynamicResource Color_Orange_1_Unofficial}"/>
        </Border.BorderBrush>
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource Color_Orange_1_Unofficial}" Opacity="0"/>
        </Border.Background>
        <Grid x:Name="Content_Layout_Grid" Margin="8,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="LeftMarginSizer_BasedOnExternalLinkTextBlock_Grid" Width="{Binding Path=ActualWidth, ElementName=ExternalLinkIcon_TextBlock}" Margin="0,0,4,0"/>
          <TextBlock x:Name="VersionName_TextBlock" TextWrapping="Wrap" TextAlignment="Center" FontFamily="{DynamicResource FontFamily_PrimaryFont}" VerticalAlignment="Center" FontWeight="Black" Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="1" LineStackingStrategy="BlockLineHeight" LineHeight="10" FontSize="{DynamicResource Single_TextSize_10}" Margin="0,5,0,4">
            <TextBlock.Foreground>
              <SolidColorBrush Color="{DynamicResource Color_Orange_1_Unofficial}"/>
