<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  xmlns:local="clr-namespace:Welcome"
  mc:Ignorable="d"
  Title="NoesisGUI - SDK Browser"
  FontFamily="{DynamicResource FontFamily_PrimaryFont}"
  d:DataContext="DataSet_Native" d:DesignWidth="1600" d:DesignHeight="900">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Page.Resources>
  <Page.Background>
    <SolidColorBrush Color="{DynamicResource Color_Blue_2_Unofficial}"/>
  </Page.Background>
  <Page.Foreground>
    <SolidColorBrush Color="{DynamicResource Color_White_1_Official}"/>
  </Page.Foreground>
  <noesis:LayoutScaler ReferenceResolution="1060,600">
    <Grid x:Name="Master_Grid">
      <Grid.Background>
        <ImageBrush Stretch="Uniform">
          <ImageBrush.Shader>
            <noesis:AbyssBrush/>
          </ImageBrush.Shader>
        </ImageBrush>
      </Grid.Background>
      <Grid x:Name="PreloadImages" Opacity="0">
        <Image Source="{StaticResource Image.Home.Bugs}"/>
        <Image Source="{StaticResource Image.Home.Changelog}"/>
        <Image Source="{StaticResource Image.Home.Docs}"/>
        <Image Source="{StaticResource Image.Home.Forums}"/>
        <Image Source="{StaticResource Image.Learn.DocsNoesisGUI}"/>
        <Image Source="{StaticResource Image.Learn.DocsStudio}"/>
        <Image Source="{StaticResource Image.Learn.VideoCharSel}"/>
        <Image Source="{StaticResource Image.Learn.VideoData}"/>
        <Image Source="{StaticResource Image.Learn.VideoMainMenu}"/>
        <Image Source="{StaticResource Image.Learn.VideoNewEra}"/>
        <Image Source="{StaticResource Image.Learn.VideoPaths}"/>
        <Image Source="{StaticResource Image.Learn.VideoStyles}"/>
        <Image Source="{StaticResource Image.Samples.BackgroundEffect}"/>
        <Image Source="{StaticResource Image.Samples.BrushShaders}"/>
        <Image Source="{StaticResource Image.Samples.CustomControl}"/>
        <Image Source="{StaticResource Image.Samples.CustomRender}"/>
        <Image Source="{StaticResource Image.Samples.DataBinding}"/>
        <Image Source="{StaticResource Image.Samples.HelloWorld}"/>
        <Image Source="{StaticResource Image.Samples.Inventory}"/>
        <Image Source="{StaticResource Image.Samples.Localization}"/>
        <Image Source="{StaticResource Image.Samples.LoginDialog}"/>
        <Image Source="{StaticResource Image.Samples.Menu3D}"/>
        <Image Source="{StaticResource Image.Samples.QuestLog}"/>
        <Image Source="{StaticResource Image.Samples.Rive}"/>
        <Image Source="{StaticResource Image.Samples.Scoreboard}"/>
        <Image Source="{StaticResource Image.Samples.StartMenu}"/>
        <Image Source="{StaticResource Image.Samples.TicTacToe}"/>
        <Image Source="{StaticResource Image.Samples.UserControl}"/>
        <Image Source="{StaticResource Image.Samples.VideoEffect}"/>
      </Grid>
      <Grid x:Name="Background_Group_Grid">
        <Grid x:Name="Background_Grid"/>
      </Grid>
      <Grid x:Name="Master_Layout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Sidebar_Group_Grid">
          <Grid x:Name="Sidebar_Background_Grid" Opacity="0.8">
            <Grid.Background>
              <SolidColorBrush Color="{DynamicResource Color_Gray_1_System}"/>
            </Grid.Background>
          </Grid>
          <Grid x:Name="Sidebar_Layout_Grid">
            <Grid.RowDefinitions>
              <RowDefinition Height="90"/>
              <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="SideBarHeader" d:DesignWidth="1920" d:DesignHeight="512">
              <Grid x:Name="Header_Background_Gradient_Grid" Opacity="0.5">
                <Grid.Background>
                  <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="{DynamicResource Color_Blue_4_Official}"/>
                    <GradientStop Offset="1" Color="#000E3B5E"/>
                  </LinearGradientBrush>
                </Grid.Background>
              </Grid>
              <StackPanel Margin="0,12,0,0" VerticalAlignment="Center">
                <Viewbox x:Name="Logo_NoesisGUI_Viewbox" Height="35">
                  <Grid x:Name="Logo_NoesisGUI_Grid">
                    <Path x:Name="Right" Data="F1M328.36,25.57 421.09,50.42 470.84,235.66 312.51,393.8 219.79,368.96 203.2,307.21 295.93,332.06 409.02,219.1 375.85,95.6 283.12,70.76 328.36,25.57z" Stretch="Fill" Width="267.64" Height="368.22998" Margin="203.2,25.57,2824.56,118.2" Fill="#FF2AA6E2"/>
                    <Path x:Name="Left" Data="F1M353.23,118.2 378.11,210.82 332.87,256 308,163.38 153.45,121.97 62.98,212.33 87.86,304.96 26.04,288.39 1.16,195.77 136.87,60.22 353.23,118.2z" Stretch="Fill" Width="376.94998" Height="244.73999" Margin="1.16,60.22,2917.29,207.04" Fill="#FF2AA6E2"/>
                    <Path x:Name="Bottom" Data="F1M223.56,169.41 161.74,152.84 93.89,220.62 151.93,436.73 337.39,486.43 405.24,418.65 388.66,356.9 320.81,424.68 197.17,391.55 155.71,237.18 223.56,169.41z" Stretch="Fill" Width="311.34998" Height="333.59" Margin="93.89,152.84,2890.16,25.57" Fill="#FF2AA6E2"/>
