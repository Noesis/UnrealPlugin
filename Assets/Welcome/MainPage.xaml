                    <Path x:Name="path8" Data="F1M857.27,323.76h-3.48c-6.95,0 -14.58,-3.58 -19.29,-7.79 -3.73,-3.34 -9.18,-10.51 -14.21,-16.3l-87.29,-132.11c-10.03,-12.79 -21.21,-23.25 -29.59,-30.29 -13.19,-5.39 -23.48,-8.11 -40.86,-8.11h-63.71v253.68h60.24v-194.61h3.48c6.95,0 11.5,2.32 17.29,5.79 5.75,5.08 11.18,10.91 15.42,17.9l87.38,133.36c10.03,13.14 17.2,21.21 26.39,29.4 12.74,5.79 26.24,9.31 44.78,9.31h63.71v-256h-60.23v195.76z M1172.85,128h-126.87c-63.71,0 -96.14,26.64 -96.14,81.09v92.67c0,53.28 32.43,81.09 96.14,81.09h126.87c63.71,0 96.15,-26.64 96.15,-81.09v-92.67c0,-53.29 -32.43,-81.09 -96.15,-81.09z M1206.45,301.76c0,13.9 -11.58,22.01 -33.59,22.01h-126.87c-22.01,0 -33.59,-6.95 -33.59,-22.01v-92.67c0,-15.06 11.58,-22.01 33.59,-22.01h126.87c22.01,0 33.59,6.95 33.59,22.01v92.67z M1362.83,311.02v-25.48h255.38v-59.08h-255.38v-25.48c0,-8.11 4.63,-12.74 13.9,-12.74h242.64v-60.24h-242.64c-50.97,0 -76.45,20.85 -76.45,61.39v129.74c0,41.7 25.48,62.55 76.45,62.55h243.8v-59.08h-243.8c-9.27,1.16 -13.9,-3.48 -13.9,-11.58z M1892.2,225.3h-166.25c-9.27,0 -15.06,-3.48 -15.06,-9.27v-19.69c0,-5.79 4.63,-9.27 15.06,-9.27h234.6v-59.08h-234.6c-50.97,0 -76.45,20.85 -76.45,61.39v40.54c0,35.91 25.48,54.44 76.45,54.44h166.25c9.27,0 13.9,3.48 13.9,9.27v20.85c0,5.79 -4.63,9.27 -13.9,9.27h-234.6v59.08h234.6c50.97,0 76.45,-20.85 76.45,-61.39v-34.75c0,-40.54 -25.48,-61.39 -76.45,-61.39h0z M1999.92,128h62.55v253.68h-62.55v-253.68z M2338.28,225.3h-166.86c-9.27,0 -15.06,-3.48 -15.06,-9.27v-19.69c0,-5.79 4.63,-9.27 15.06,-9.27h235.2v-59.08h-235.2c-50.97,0 -76.45,20.85 -76.45,61.39v40.54c0,35.91 25.48,54.44 76.45,54.44h166.86c9.27,0 13.9,3.48 13.9,9.27v20.85c0,5.79 -4.63,9.27 -13.9,9.27h-235.2v59.08h235.2c50.97,0 76.45,-20.85 76.45,-61.39v-34.75c-1.16,-40.54 -26.64,-61.39 -76.45,-61.39h0z" Stretch="Fill" Width="1815.8899" Height="256.00003" Margin="598.84,127.99,880.67,128.01" Fill="#FFF2F2F2"/>
                  </Grid>
                </Viewbox>
                <Border Margin="0,2,0,0" HorizontalAlignment="Center" Padding="8,2,8,2" CornerRadius="4,4,4,4">
                  <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_Blue_2_Unofficial}"/>
                  </Border.Background>
                  <TextBlock Text="{Binding Path=Version}" HorizontalAlignment="Center" FontSize="{DynamicResource Single_TextSize_11}" FontWeight="Bold" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="SidebarButtons_StackPanel" Grid.Row="1" VerticalAlignment="Top">
              <TabControl x:Name="SidebarTabs" TabStripPlacement="Left" Margin="0,16,0,4" Template="{DynamicResource Template_TabControl_PageComposition}">
                <TabItem x:Name="Welcome_TabItem" Header="Getting Started&#x0A;Unreal Plugin" Custom.Icon_DataTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_Sidebar_Unreal}" Template="{DynamicResource Template_TabControl_TabItem}">
                  <Grid>
                    <ContentControl x:Name="Welcome_ContentControl" Content="{Binding}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Page_Welcome}"/>
                  </Grid>
                </TabItem>
                <TabItem x:Name="Learn_TabItem" Header="Runtime &amp; Studio&#x0A;Resources" Custom.Icon_DataTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_Sidebar_Forums}" Template="{DynamicResource Template_TabControl_TabItem}">
                  <Grid>
                    <ContentControl x:Name="Learn_ContentControl" Content="{Binding}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Page_Learn}"/>
                  </Grid>
                </TabItem>
                <TabItem x:Name="Samples_TabItem" Header="Explore the&#x0A;Sample Library" Custom.Icon_DataTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_Sidebar_Samples}" Template="{DynamicResource Template_TabControl_TabItem}">
                  <Grid>
                    <ContentControl x:Name="Samples_ContentControl" Content="{Binding}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Page_Samples}"/>
                  </Grid>
                </TabItem>
              </TabControl>
            </StackPanel>
            <Grid x:Name="Footer__Group_Grid" Grid.Row="1" VerticalAlignment="Bottom">
              <Grid x:Name="Footer_Margined_Grid" Margin="8,8,8,8" HorizontalAlignment="Center">
                <StackPanel x:Name="Footer_VerticalStack">
                  <Border x:Name="LinkBar_Border" Width="240" Height="24" Margin="0,8,0,8" BorderThickness="{DynamicResource Thickness_FrameBorderThickness}" CornerRadius="{DynamicResource CornerRadius_Level1}">
                    <Grid x:Name="ButtonRow_Grid">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="328*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="328*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="328*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="322*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="328*"/>
                      </Grid.ColumnDefinitions>
                      <Button Content="VSCode" Tag="4,0,0,4" Template="{DynamicResource Template_Button_LinkBarButton}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_LinkBar_VSCode}">
                        <b:Interaction.Triggers>
                          <b:EventTrigger EventName="Click">
                            <b:LaunchUriOrFileAction Path="https://noesisengine.com/vscode"/>
                          </b:EventTrigger>
                        </b:Interaction.Triggers>
                      </Button>
                      <Rectangle Width="1" Grid.Column="1">
                        <Rectangle.Fill>
                          <SolidColorBrush Color="{DynamicResource Color_Gray_2_Unofficial}"/>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Button Content="X" Grid.Column="2" Tag="0,0,0,0" Template="{DynamicResource Template_Button_LinkBarButton}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_LinkBar_X}">
                        <b:Interaction.Triggers>
                          <b:EventTrigger EventName="Click">
                            <b:LaunchUriOrFileAction Path="https://x.com/noesisengine"/>
                          </b:EventTrigger>
                        </b:Interaction.Triggers>
                      </Button>
                      <Rectangle Width="1" Grid.Column="3">
                        <Rectangle.Fill>
                          <SolidColorBrush Color="{DynamicResource Color_Gray_2_Unofficial}"/>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Button Content="Youtube" Grid.Column="4" Tag="0,0,0,0" Template="{DynamicResource Template_Button_LinkBarButton}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_LinkBar_YouTube}">
                        <b:Interaction.Triggers>
                          <b:EventTrigger EventName="Click">
                            <b:LaunchUriOrFileAction Path="https://www.youtube.com/user/noesistechnologies"/>
                          </b:EventTrigger>
                        </b:Interaction.Triggers>
                      </Button>
                      <Rectangle Width="1" Grid.Column="5">
                        <Rectangle.Fill>
                          <SolidColorBrush Color="{DynamicResource Color_Gray_2_Unofficial}"/>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Button Content="LinkedIn" Grid.Column="6" Tag="0,0,0,0" Template="{DynamicResource Template_Button_LinkBarButton}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_LinkBar_LinkedIn}">
                        <b:Interaction.Triggers>
                          <b:EventTrigger EventName="Click">
                            <b:LaunchUriOrFileAction Path="https://www.linkedin.com/company/noesisgui"/>
                          </b:EventTrigger>
                        </b:Interaction.Triggers>
                      </Button>
                      <Rectangle Width="1" Grid.Column="7">
                        <Rectangle.Fill>
                          <SolidColorBrush Color="{DynamicResource Color_Gray_2_Unofficial}"/>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Button Content="GitHub" Grid.Column="8" Tag="0,4,4,0" Template="{DynamicResource Template_Button_LinkBarButton}" ContentTemplate="{DynamicResource DataTemplate_ContentControl_Content_Icon_LinkBar_GitHub}">
                        <b:Interaction.Triggers>
                          <b:EventTrigger EventName="Click">
                            <b:LaunchUriOrFileAction Path="https://github.com/Noesis"/>
                          </b:EventTrigger>
                        </b:Interaction.Triggers>
                      </Button>
                    </Grid>
                  </Border>
                  <TextBlock Text="© 2013 Noesis Technologies S.L. All Rights Reserved" FontSize="8" FontWeight="Light" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
        <Grid x:Name="ContentArea_Grid" Grid.Column="1">
          <ContentPresenter Content="{Binding Path=SelectedContent, ElementName=SidebarTabs}"/>
        </Grid>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Page>
